{
  "name": "RAG Consultant - Company Knowledge Base",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger-1",
      "name": "Run Manually (Document Ingestion)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-64, 0],
      "notes": "Step 1: Run this trigger manually to upload company documents into the Pinecone knowledge base. Do this once, or whenever you update your documents."
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": { "__rl": true, "mode": "id", "value": "" },
        "options": {}
      },
      "id": "google-drive-1",
      "name": "Download Document from Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [160, 0],
      "notes": "Insert the Google Drive file ID of your PDF document (e.g. company policy, price list, internal procedures)."
    },
    {
      "parameters": { "operation": "pdf", "options": {} },
      "id": "extract-file-1",
      "name": "Extract Text from Document",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [384, 0]
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": { "__rl": true, "mode": "id", "value": "" },
        "options": {}
      },
      "id": "pinecone-insert-1",
      "name": "Pinecone - Store Knowledge",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1,
      "position": [608, 0],
      "notes": "Insert your Pinecone index name. This is where the document knowledge is stored as vectors."
    },
    {
      "parameters": { "options": {} },
      "id": "embeddings-insert-1",
      "name": "OpenAI Embeddings (Ingestion)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [448, 224]
    },
    {
      "parameters": { "options": {} },
      "id": "data-loader-1",
      "name": "Document Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [720, 224]
    },
    {
      "parameters": { "chunkOverlap": 200, "options": {} },
      "id": "text-splitter-1",
      "name": "Split Text into Chunks",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [816, 432],
      "notes": "Splits long documents into smaller chunks. chunkOverlap=200 ensures context continuity between chunks."
    },
    {
      "parameters": { "updates": ["messages"], "options": {} },
      "id": "whatsapp-trigger-1",
      "name": "WhatsApp Message Received",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [-64, 640],
      "notes": "Step 2: Receives incoming messages from consultants via WhatsApp Business API. Each message triggers the AI agent."
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are a helpful internal company assistant. You answer employees' questions exclusively based on the company documents available in the knowledge base. If you cannot find the answer in the documents, clearly state that and suggest contacting the appropriate department. Always be professional, concise, and accurate."
        }
      },
      "id": "agent-1",
      "name": "AI Consultant Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [224, 640],
      "notes": "The AI agent uses the Pinecone knowledge base to answer consultant questions."
    },
    {
      "parameters": { "model": "gpt-4o", "options": {} },
      "id": "openai-model-1",
      "name": "GPT-4o Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [80, 864]
    },
    {
      "parameters": { "contextWindowLength": 10 },
      "id": "memory-1",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1,
      "position": [224, 864],
      "notes": "Stores the last 10 messages so the agent remembers conversation context."
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "company_knowledge_base",
        "toolDescription": "Searches the company knowledge base containing internal documents, procedures, policies and other company materials. Use this tool to answer any questions related to the company.",
        "pineconeIndex": { "__rl": true, "mode": "id", "value": "" },
        "options": {}
      },
      "id": "pinecone-retrieve-1",
      "name": "Pinecone - Search Knowledge",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1,
      "position": [432, 848],
      "notes": "This node searches Pinecone and returns relevant document chunks to the agent."
    },
    {
      "parameters": { "options": {} },
      "id": "embeddings-retrieve-1",
      "name": "OpenAI Embeddings (Search)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [272, 1056]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $('WhatsApp Message Received').item.json.metadata.phone_number_id }}",
        "recipientPhoneNumber": "={{ $('WhatsApp Message Received').item.json.contacts[0].wa_id }}",
        "textBody": "={{ $json.output }}",
        "additionalFields": {}
      },
      "id": "whatsapp-reply-1",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [624, 640],
      "notes": "Sends the AI agent's response back to the consultant via WhatsApp Business API."
    }
  ],
  "pinData": {},
  "connections": {
    "Run Manually (Document Ingestion)": {
      "main": [[{ "node": "Download Document from Google Drive", "type": "main", "index": 0 }]]
    },
    "Download Document from Google Drive": {
      "main": [[{ "node": "Extract Text from Document", "type": "main", "index": 0 }]]
    },
    "Extract Text from Document": {
      "main": [[{ "node": "Pinecone - Store Knowledge", "type": "main", "index": 0 }]]
    },
    "OpenAI Embeddings (Ingestion)": {
      "ai_embedding": [[{ "node": "Pinecone - Store Knowledge", "type": "ai_embedding", "index": 0 }]]
    },
    "Document Loader": {
      "ai_document": [[{ "node": "Pinecone - Store Knowledge", "type": "ai_document", "index": 0 }]]
    },
    "Split Text into Chunks": {
      "ai_textSplitter": [[{ "node": "Document Loader", "type": "ai_textSplitter", "index": 0 }]]
    },
    "WhatsApp Message Received": {
      "main": [[{ "node": "AI Consultant Agent", "type": "main", "index": 0 }]]
    },
    "GPT-4o Model": {
      "ai_languageModel": [[{ "node": "AI Consultant Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "Conversation Memory": {
      "ai_memory": [[{ "node": "AI Consultant Agent", "type": "ai_memory", "index": 0 }]]
    },
    "Pinecone - Search Knowledge": {
      "ai_tool": [[{ "node": "AI Consultant Agent", "type": "ai_tool", "index": 0 }]]
    },
    "OpenAI Embeddings (Search)": {
      "ai_embedding": [[{ "node": "Pinecone - Search Knowledge", "type": "ai_embedding", "index": 0 }]]
    },
    "AI Consultant Agent": {
      "main": [[{ "node": "Send WhatsApp Reply", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  }
}
